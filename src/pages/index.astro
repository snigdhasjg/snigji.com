---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { skills } from '../data/skills';
import { projects } from '../data/projects';
import { education } from '../data/education';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="snigji.com" description={profile.summary}>
  <section id="about">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="meta">{profile.location} · {profile.languages.join(', ')}</p>
    <p>{profile.summary}</p>
  </section>

  <section id="experience">
    <h2>experience</h2>
    {experience.map((job) => (
      <article class="job">
        <h3>{job.role} <span class="at">@ {job.company}</span></h3>
        <p class="period">{job.period}</p>
        <ul>
          {job.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <ul class="tag-list">
          {job.tech.map((t) => <li>{t}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <section id="skills">
    <h2>skills</h2>
    <div class="skills-grid">
      {skills.map((group) => (
        <div class="skill-group">
          <h3>{group.label}</h3>
          <ul class="tag-list">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="projects">
    <h2>projects</h2>
    {projects.map((project) => (
      <article class="project">
        <h3>{project.name}</h3>
        <p>{project.description}</p>
        <ul class="tag-list">
          {project.tech.map((t) => <li>{t}</li>)}
        </ul>
        {project.links && (
          <p class="project-links">
            {project.links.map((link, i) => (
              <>
                {i > 0 && ' · '}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
          </p>
        )}
      </article>
    ))}
  </section>

  <section id="education">
    <h2>education</h2>
    {education.map((item) => (
      <article class="edu">
        <h3>{item.field}</h3>
        <p class="period">{item.degree} · {item.institution} · {item.period}{item.grade && ` · ${item.grade}`}</p>
      </article>
    ))}
  </section>

  <section id="publications">
    <h2>publications</h2>
    {publications.map((pub) => (
      <article class="pub">
        <h3>{pub.title}</h3>
        <p class="period">{pub.venue} · {pub.date}</p>
        <p>{pub.summary}</p>
        {pub.links && (
          <p class="project-links">
            {pub.links.map((link, i) => (
              <>
                {i > 0 && ' · '}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
          </p>
        )}
      </article>
    ))}
  </section>

  {posts.length > 0 && (
    <section id="writing">
      <h2>writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <span class="post-date">{dateFmt(post.data.pubDate)}</span>
          </li>
        ))}
      </ul>
      <p><a href="/blog">all posts →</a></p>
    </section>
  )}

  <section id="contact">
    <h2>contact</h2>
    <p>
      Reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a> or find me on <a href={profile.links.linkedin}>LinkedIn</a>.
    </p>
  </section>
</Base>

<style>
  .headline {
    font-family: var(--font-mono);
    color: var(--fg-dim);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .job .at {
    color: var(--fg-dim);
    font-weight: 400;
    font-size: 0.85em;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin: -0.3em 0 0.6em;
  }

  .job + .job,
  .project + .project,
  .edu + .edu,
  .pub + .pub {
    margin-top: var(--space-3);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-2) var(--space-3);
  }

  .skill-group h3 {
    margin-top: 0;
    font-size: 0.95rem;
    color: var(--fg-dim);
    font-weight: 500;
  }

  .project-links {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    border-bottom: 1px solid var(--border);
    padding: 0.5em 0;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
    white-space: nowrap;
  }
</style>
